{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "reelrelay",
	"main": "src/index.ts",
	"compatibility_date": "2025-02-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "reelrelay-db",
			"database_id": "702d883d-ea4b-4d7f-b470-a07491ae3837"
		}
	]
}