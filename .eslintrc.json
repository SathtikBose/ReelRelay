{
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "plugins": ["security"],
  "extends": ["eslint:recommended", "plugin:security/recommended-legacy"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-console": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "security/detect-object-injection": "off"
  }
}
