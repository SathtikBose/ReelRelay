<%- include('../partials/header') %>

<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
  <div>
    <h1 style="font-size: 24px; font-weight: 700;">Instagram Dashboard</h1>
    <p style="color: var(--muted); font-size: 14px;">Real-time overview of automated Instagram comment replies</p>
  </div>
  <a href="/admin/instagram/reels/new" class="btn btn-primary">
    <span>+ New Reel Rule</span>
  </a>
</div>

<!-- Alert Banners -->
<% if (alerts && alerts.length > 0) { %>
  <div style="margin-bottom: 20px; display: flex; flex-direction: column; gap: 10px;">
    <% alerts.forEach(function(alert) { %>
      <div style="background-color: <%= alert.type === 'danger' ? 'rgba(220, 38, 38, 0.1)' : 'rgba(217, 119, 6, 0.1)' %>; border: 1px solid <%= alert.type === 'danger' ? 'var(--danger)' : 'var(--warning)' %>; color: <%= alert.type === 'danger' ? 'var(--danger)' : 'var(--warning)' %>; padding: 12px 16px; border-radius: var(--input-radius); font-size: 14px; display: flex; align-items: center; gap: 8px;">
        <span><%= alert.type === 'danger' ? '⚠️' : '🔔' %></span>
        <span><%= alert.message %></span>
      </div>
    <% }); %>
  </div>
<% } %>

<!-- Stat Cards Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 24px;">
  <div class="card" style="margin-bottom: 0; padding: 16px;">
    <div style="font-size: 13px; color: var(--muted); margin-bottom: 4px;">Sent (Today)</div>
    <div style="font-size: 28px; font-weight: 700; color: var(--success);"><%= stats.sentToday %></div>
  </div>

  <div class="card" style="margin-bottom: 0; padding: 16px;">
    <div style="font-size: 13px; color: var(--muted); margin-bottom: 4px;">Sent (7 Days)</div>
    <div style="font-size: 28px; font-weight: 700; color: var(--primary);"><%= stats.sent7Days %></div>
  </div>

  <div class="card" style="margin-bottom: 0; padding: 16px;">
    <div style="font-size: 13px; color: var(--muted); margin-bottom: 4px;">Failed DMs</div>
    <div style="font-size: 28px; font-weight: 700; color: <%= stats.failedTotal > 0 ? 'var(--danger)' : 'var(--muted)' %>;"><%= stats.failedTotal %></div>
  </div>

  <div class="card" style="margin-bottom: 0; padding: 16px;">
    <div style="font-size: 13px; color: var(--muted); margin-bottom: 4px;">Active Rules</div>
    <div style="font-size: 28px; font-weight: 700; color: var(--text);"><%= stats.activeRules %></div>
  </div>

  <div class="card" style="margin-bottom: 0; padding: 16px;">
    <div style="font-size: 13px; color: var(--muted); margin-bottom: 4px;">Token Validity</div>
    <div style="font-size: 28px; font-weight: 700; color: <%= (stats.tokenDaysLeft !== null && stats.tokenDaysLeft < 15) ? 'var(--warning)' : 'var(--text)' %>;">
      <%= stats.tokenDaysLeft !== null ? stats.tokenDaysLeft + 'd' : '—' %>
    </div>
  </div>
</div>

<!-- Recent Activity Section -->
<div class="card">
  <div class="card-header">
    <h2 class="card-title">Recent Activity (Last 10)</h2>
    <a href="/admin/instagram/activity" style="font-size: 14px; font-weight: 500;">View All Activity →</a>
  </div>

  <% if (!recentActivity || recentActivity.length === 0) { %>
    <p style="color: var(--muted); font-size: 14px; padding: 12px 0;">No comments or DM replies logged yet.</p>
  <% } else { %>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 14px; text-align: left;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border); color: var(--muted);">
            <th style="padding: 8px 12px;">Time</th>
            <th style="padding: 8px 12px;">User</th>
            <th style="padding: 8px 12px;">Comment</th>
            <th style="padding: 8px 12px;">Keyword</th>
            <th style="padding: 8px 12px;">Status</th>
          </tr>
        </thead>
        <tbody>
          <% recentActivity.forEach(function(log) { %>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 10px 12px; white-space: nowrap; color: var(--muted); font-size: 13px;">
                <%= new Date(log.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
              </td>
              <td style="padding: 10px 12px; font-weight: 500;">
                @<%= log.commenterUsername || 'user' %>
              </td>
              <td style="padding: 10px 12px; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <%= log.commentText %>
              </td>
              <td style="padding: 10px 12px;">
                <% if (log.matchedKeyword) { %>
                  <span class="chip" style="font-size: 11px; padding: 2px 8px;"><%= log.matchedKeyword %></span>
                <% } else { %>
                  <span style="color: var(--muted); font-size: 12px;">—</span>
                <% } %>
              </td>
              <td style="padding: 10px 12px;">
                <% if (log.status === 'sent') { %>
                  <span class="badge badge-active">Sent</span>
                <% } else if (log.status === 'failed') { %>
                  <span class="badge" style="background: rgba(220, 38, 38, 0.15); color: var(--danger);">Failed</span>
                <% } else if (log.status === 'skipped') { %>
                  <span class="badge badge-paused">Skipped</span>
                <% } else { %>
                  <span class="badge" style="background: rgba(108, 92, 231, 0.15); color: var(--primary);"><%= log.status %></span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
