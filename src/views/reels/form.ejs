<%- include('../partials/header') %>

<div style="margin-bottom: 24px;">
  <a href="/admin/instagram/reels" style="font-size: 14px; color: var(--muted); display: inline-flex; align-items: center; gap: 4px; margin-bottom: 8px;">
    ← Back to Reel Rules
  </a>
  <h1 style="font-size: 24px; font-weight: 700;"><%= isEdit ? 'Edit Reel Rule' : 'New Reel Rule' %></h1>
  <p style="color: var(--muted); font-size: 14px;">
    Configure automated Instagram DM replies when commenters use specific keywords
  </p>
</div>

<% if (errors.general) { %>
  <div style="background-color: rgba(220, 38, 38, 0.1); border: 1px solid var(--danger); color: var(--danger); padding: 12px 16px; border-radius: var(--input-radius); margin-bottom: 20px; font-size: 14px;">
    <%= errors.general %>
  </div>
<% } %>

<form action="<%= isEdit ? '/admin/instagram/reels/' + rule._id : '/admin/instagram/reels' %>" method="POST" id="rule-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  
  <!-- Hidden fields for picker metadata -->
  <input type="hidden" id="caption-snippet-input" name="caption" value="<%= rule.caption || rule.captionSnippet || '' %>">
  <input type="hidden" id="thumbnail-url-input" name="thumbnailUrl" value="<%= rule.thumbnailUrl || '' %>">
  <input type="hidden" id="permalink-input" name="permalink" value="<%= rule.permalink || '' %>">

  <!-- Step 1: Reel Selection -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">1. Instagram Reel</h2>
    </div>

    <% if (!isEdit) { %>
      <div style="margin-bottom: 16px;">
        <button type="button" id="load-picker-btn" class="btn btn-secondary">
          📹 Select from Recent Reels
        </button>
        <div id="picker-loading" style="display:none; margin-top: 10px; font-size: 14px; color: var(--muted);">
          Loading recent reels from Instagram...
        </div>
        <div id="picker-error" style="display:none; margin-top: 10px; color: var(--danger); font-size: 13px;"></div>
        <div id="picker-grid" class="picker-grid" style="margin-top: 12px;"></div>
      </div>
    <% } %>

    <div class="form-group">
      <label for="media-id-input" class="form-label">Instagram Media ID</label>
      <input 
        type="text" 
        id="media-id-input" 
        name="mediaId" 
        class="form-input" 
        value="<%= rule.mediaId || '' %>" 
        required 
        placeholder="e.g. 17987654321098765"
        <%= isEdit ? 'readonly style="background-color:var(--bg);cursor:not-allowed;"' : '' %>
      >
      <% if (errors.mediaId) { %>
        <div class="form-error"><%= errors.mediaId %></div>
      <% } else { %>
        <div class="form-hint">Unique numeric ID of the Instagram Reel.</div>
      <% } %>
    </div>
  </div>

  <!-- Step 2: Keywords & Match Mode -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">2. Keywords & Match Mode</h2>
    </div>

    <div class="form-group">
      <label for="keyword-chip-input" class="form-label">Trigger Keywords (Max 10)</label>
      <div class="chip-container" id="keyword-chips-container">
        <input 
          type="text" 
          id="keyword-chip-input" 
          class="chip-input" 
          placeholder="Type keyword and press Enter or comma..." 
          autocomplete="off"
        >
      </div>
      <input 
        type="hidden" 
        id="keywords-hidden" 
        name="keywords" 
        value="<%= Array.isArray(rule.keywords) ? rule.keywords.join(',') : (rule.keywords || '') %>"
      >
      <% if (errors.keywords) { %>
        <div class="form-error"><%= errors.keywords %></div>
      <% } else { %>
        <div class="form-hint">Case-insensitive. Commas or Enter separate keywords.</div>
      <% } %>
    </div>

    <div class="form-group">
      <label class="form-label">Match Mode</label>
      <div class="segmented-control">
        <label class="segment-option <%= (rule.matchMode || 'word') === 'word' ? 'active' : '' %>">
          <input type="radio" name="matchMode" value="word" <%= (rule.matchMode || 'word') === 'word' ? 'checked' : '' %>>
          Whole Word
        </label>
        <label class="segment-option <%= rule.matchMode === 'exact' ? 'active' : '' %>">
          <input type="radio" name="matchMode" value="exact" <%= rule.matchMode === 'exact' ? 'checked' : '' %>>
          Exact Comment
        </label>
        <label class="segment-option <%= rule.matchMode === 'contains' ? 'active' : '' %>">
          <input type="radio" name="matchMode" value="contains" <%= rule.matchMode === 'contains' ? 'checked' : '' %>>
          Contains Substring
        </label>
      </div>
      <div class="form-hint" style="margin-top: 8px;">
        <strong>Whole word:</strong> Matches "LINK" or "send LINK please", ignores "linkedin".<br>
        <strong>Exact comment:</strong> Matches only if the entire comment is the keyword.<br>
        <strong>Contains:</strong> Matches any comment containing the keyword (including "linkedin").
      </div>
    </div>
  </div>

  <!-- Step 3: Destination Link & Template -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">3. DM Reply & Link</h2>
    </div>

    <div class="form-group">
      <label for="link-input" class="form-label">Destination Link (HTTPS)</label>
      <div style="display: flex; gap: 8px;">
        <input 
          type="url" 
          id="link-input" 
          name="link" 
          class="form-input" 
          value="<%= rule.link || '' %>" 
          required 
          placeholder="https://example.com/your-resource"
        >
        <button 
          type="button" 
          id="test-link-btn"
          class="btn btn-secondary" 
          style="flex-shrink: 0;"
        >
          Test Link ↗
        </button>
      </div>
      <% if (errors.link) { %>
        <div class="form-error"><%= errors.link %></div>
      <% } else { %>
        <div class="form-hint">The target URL that will be inserted into {{link}}.</div>
      <% } %>
    </div>

    <div class="form-group">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
        <label for="template-input" class="form-label" style="margin-bottom:0;">DM Message Template</label>
        <span id="char-counter" style="font-size: 12px; color: var(--muted);">0 / 800</span>
      </div>

      <div style="display: flex; gap: 6px; margin-bottom: 8px;">
        <button type="button" class="btn btn-secondary btn-sm var-chip" data-tag="{{link}}">+ {{link}}</button>
        <button type="button" class="btn btn-secondary btn-sm var-chip" data-tag="{{username}}">+ {{username}}</button>
        <button type="button" class="btn btn-secondary btn-sm var-chip" data-tag="{{keyword}}">+ {{keyword}}</button>
      </div>

      <textarea 
        id="template-input" 
        name="dmTemplate" 
        class="form-textarea" 
        rows="4" 
        maxlength="800" 
        required
      ><%= rule.dmTemplate || rule.template || 'Hey {{username}}! 👋 Here\'s the link you asked for:\n{{link}}' %></textarea>
      <% if (errors.dmTemplate || errors.template) { %>
        <div class="form-error"><%= errors.dmTemplate || errors.template %></div>
      <% } %>

      <div class="preview-bubble-container">
        <div style="font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 8px;">
          Live Instagram DM Preview:
        </div>
        <div id="preview-bubble" class="preview-bubble"></div>
      </div>
    </div>

    <div class="form-group" style="margin-top: 16px;">
      <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 14px; font-weight: 500;">
        <% const isChecked = (rule.active !== false && rule.isActive !== false); %>
        <input 
          type="checkbox" 
          name="active" 
          style="width: 18px; height: 18px; accent-color: var(--primary);"
          <%= isChecked ? 'checked' : '' %>
        >
        <span>Rule Active (send automated replies when matched)</span>
      </label>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px;">
    <a href="/admin/instagram/reels" class="btn btn-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">
      <%= isEdit ? 'Save Changes' : 'Create Reel Rule' %>
    </button>
  </div>
</form>

<%- include('../partials/footer') %>
