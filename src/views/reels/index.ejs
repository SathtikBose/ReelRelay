<%- include('../partials/header') %>

<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
  <div>
    <h1 style="font-size: 24px; font-weight: 700;">Instagram Reel Rules</h1>
    <p style="color: var(--muted); font-size: 14px;">Automated DM replies configured for your Instagram Reels</p>
  </div>
  <a href="/admin/instagram/reels/new" class="btn btn-primary">
    <span>+ New Reel Rule</span>
  </a>
</div>

<% if (!reels || reels.length === 0) { %>
  <div class="card empty-state">
    <h3>No reel rules yet</h3>
    <p>Add your first reel rule to start sending automated private replies to commenter keywords.</p>
    <a href="/admin/instagram/reels/new" class="btn btn-primary">+ Add Your First Reel</a>
  </div>
<% } else { %>
  <div class="reels-grid">
    <% reels.forEach(function(rule) { %>
      <% const isRuleActive = rule.active !== undefined ? rule.active : rule.isActive; %>
      <div class="reel-card">
        <div class="reel-card-header">
          <% if (rule.thumbnailUrl) { %>
            <img src="<%= rule.thumbnailUrl %>" alt="Reel thumbnail" class="reel-thumb" />
          <% } else { %>
            <div class="reel-thumb-placeholder">🎬</div>
          <% } %>
          <div class="reel-info">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
              <span class="badge <%= isRuleActive ? 'badge-active' : 'badge-paused' %>">
                <%= isRuleActive ? 'Active' : 'Paused' %>
              </span>
              <span class="reel-meta">Media ID: <%= rule.mediaId %></span>
            </div>
            <div class="reel-caption">
              <%= rule.caption || rule.captionSnippet || 'No caption available' %>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px;">
              <% (rule.keywords || []).forEach(function(kw) { %>
                <span class="chip" style="font-size: 11px; padding: 2px 8px;"><%= kw %></span>
              <% }); %>
              <span style="font-size: 11px; color: var(--muted); align-self: center; margin-left: 4px;">
                (<%= rule.matchMode %> mode)
              </span>
            </div>
          </div>
        </div>

        <div style="font-size: 13px; color: var(--muted); word-break: break-all;">
          <strong>Link:</strong> 
          <a href="<%= rule.link %>" target="_blank" rel="noopener noreferrer"><%= rule.link %></a>
        </div>

        <div class="reel-stats">
          <span>Matched: <strong><%= rule.stats?.matched || 0 %></strong></span>
          <span>Sent: <strong style="color: var(--success);"><%= rule.stats?.sent || 0 %></strong></span>
          <span>Failed: <strong style="color: <%= (rule.stats?.failed || 0) > 0 ? 'var(--danger)' : 'var(--muted)' %>;"><%= rule.stats?.failed || 0 %></strong></span>
        </div>

        <div class="reel-actions">
          <form action="/admin/instagram/reels/<%= rule._id %>/toggle" method="POST" style="margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-secondary btn-sm">
              <%= isRuleActive ? 'Pause' : 'Activate' %>
            </button>
          </form>
          <a href="/admin/instagram/reels/<%= rule._id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
          <form action="/admin/instagram/reels/<%= rule._id %>/delete" method="POST" style="margin:0;" data-confirm="Are you sure you want to delete this rule?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger);">Delete</button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('../partials/footer') %>
