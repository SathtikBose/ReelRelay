<%- include('../partials/header') %>

<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
  <div>
    <h1 style="font-size: 24px; font-weight: 700;">Activity Log</h1>
    <p style="color: var(--muted); font-size: 14px;">Total records: <%= totalCount %></p>
  </div>
</div>

<!-- Filter Bar -->
<div class="card" style="padding: 14px; margin-bottom: 20px;">
  <form action="/admin/instagram/activity" method="GET" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
    <div style="flex: 1; min-width: 140px;">
      <label for="status-filter" style="display: block; font-size: 12px; color: var(--muted); margin-bottom: 4px;">Status</label>
      <select id="status-filter" name="status" class="form-select" style="padding: 6px 10px; font-size: 14px;">
        <option value="all" <%= currentStatus === 'all' ? 'selected' : '' %>>All Statuses</option>
        <option value="sent" <%= currentStatus === 'sent' ? 'selected' : '' %>>Sent</option>
        <option value="failed" <%= currentStatus === 'failed' ? 'selected' : '' %>>Failed</option>
        <option value="skipped" <%= currentStatus === 'skipped' ? 'selected' : '' %>>Skipped</option>
        <option value="processing" <%= currentStatus === 'processing' ? 'selected' : '' %>>Processing</option>
      </select>
    </div>

    <div style="flex: 1; min-width: 180px;">
      <label for="media-filter" style="display: block; font-size: 12px; color: var(--muted); margin-bottom: 4px;">Reel</label>
      <select id="media-filter" name="mediaId" class="form-select" style="padding: 6px 10px; font-size: 14px;">
        <option value="">All Reels</option>
        <% (reels || []).forEach(function(r) { %>
          <option value="<%= r.mediaId %>" <%= currentMediaId === r.mediaId ? 'selected' : '' %>>
            <%= r.mediaId %> <%= r.caption ? '— ' + r.caption.slice(0, 30) + '...' : '' %>
          </option>
        <% }); %>
      </select>
    </div>

    <div style="align-self: flex-end;">
      <button type="submit" class="btn btn-secondary btn-sm" style="height: 38px;">Filter</button>
      <% if (currentStatus !== 'all' || currentMediaId) { %>
        <a href="/admin/instagram/activity" class="btn btn-secondary btn-sm" style="height: 38px;">Reset</a>
      <% } %>
    </div>
  </form>
</div>

<!-- Activity Table -->
<div class="card" style="padding: 0; overflow: hidden;">
  <% if (!logs || logs.length === 0) { %>
    <div class="empty-state">
      <h3>No activity found</h3>
      <p>No comment replies match the selected filters.</p>
    </div>
  <% } else { %>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 14px; text-align: left;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border); background-color: var(--bg); color: var(--muted);">
            <th style="padding: 12px 14px;">Time</th>
            <th style="padding: 12px 14px;">User</th>
            <th style="padding: 12px 14px;">Comment</th>
            <th style="padding: 12px 14px;">Keyword</th>
            <th style="padding: 12px 14px;">Status</th>
            <th style="padding: 12px 14px; text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function(log) { %>
            <% const isEligibleForRetry = log.status === 'failed' && (now - new Date(log.createdAt).getTime() < SEVEN_DAYS_MS); %>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 12px 14px; white-space: nowrap; color: var(--muted); font-size: 13px;">
                <%= new Date(log.createdAt).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' }) %>
              </td>
              <td style="padding: 12px 14px; font-weight: 500;">
                @<%= log.commenterUsername || 'user' %>
                <div style="font-size: 11px; color: var(--muted); font-weight: normal;">Reel: <%= log.mediaId %></div>
              </td>
              <td style="padding: 12px 14px; max-width: 250px;">
                <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= log.commentText %></div>
                <% if (log.errorMessage) { %>
                  <details style="margin-top: 4px; font-size: 12px; color: var(--danger);">
                    <summary style="cursor: pointer;">Error info</summary>
                    <div style="padding: 4px 6px; background: rgba(220, 38, 38, 0.08); border-radius: 4px; margin-top: 2px;">
                      <%= log.errorMessage %>
                    </div>
                  </details>
                <% } %>
                <% if (log.skipReason) { %>
                  <div style="font-size: 11px; color: var(--muted); margin-top: 2px;">
                    Reason: <%= log.skipReason %>
                  </div>
                <% } %>
              </td>
              <td style="padding: 12px 14px;">
                <% if (log.matchedKeyword) { %>
                  <span class="chip" style="font-size: 11px; padding: 2px 8px;"><%= log.matchedKeyword %></span>
                <% } else { %>
                  <span style="color: var(--muted); font-size: 12px;">—</span>
                <% } %>
              </td>
              <td style="padding: 12px 14px;">
                <% if (log.status === 'sent') { %>
                  <span class="badge badge-active">Sent</span>
                <% } else if (log.status === 'failed') { %>
                  <span class="badge" style="background: rgba(220, 38, 38, 0.15); color: var(--danger);">Failed</span>
                <% } else if (log.status === 'skipped') { %>
                  <span class="badge badge-paused">Skipped</span>
                <% } else { %>
                  <span class="badge" style="background: rgba(108, 92, 231, 0.15); color: var(--primary);"><%= log.status %></span>
                <% } %>
              </td>
              <td style="padding: 12px 14px; text-align: right; white-space: nowrap;">
                <% if (isEligibleForRetry) { %>
                  <form action="/admin/instagram/activity/<%= log._id %>/retry" method="POST" style="margin: 0; display: inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-secondary btn-sm" title="Retry sending DM (available within 7 days of comment)">
                      🔄 Retry
                    </button>
                  </form>
                <% } else if (log.status === 'failed') { %>
                  <span style="font-size: 11px; color: var(--muted); title='Older than 7 days'">Expired (>7d)</span>
                <% } else { %>
                  <span style="color: var(--muted); font-size: 12px;">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Pagination Bar -->
<% if (totalPages > 1) { %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px;">
    <div style="font-size: 13px; color: var(--muted);">
      Page <%= currentPage %> of <%= totalPages %>
    </div>
    <div style="display: flex; gap: 8px;">
      <% if (currentPage > 1) { %>
        <a href="/admin/instagram/activity?page=<%= currentPage - 1 %>&status=<%= currentStatus %>&mediaId=<%= currentMediaId %>" class="btn btn-secondary btn-sm">
          ← Previous
        </a>
      <% } %>
      <% if (currentPage < totalPages) { %>
        <a href="/admin/instagram/activity?page=<%= currentPage + 1 %>&status=<%= currentStatus %>&mediaId=<%= currentMediaId %>" class="btn btn-secondary btn-sm">
          Next →
        </a>
      <% } %>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
