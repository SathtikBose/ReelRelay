<%
  const currentPlatform = typeof platform !== 'undefined' ? platform : 'instagram';
  const currentSection = typeof section !== 'undefined' ? section : (typeof activeNav !== 'undefined' ? activeNav : 'dashboard');
%>
<% if (currentPlatform === 'instagram') { %>
  <nav class="desktop-nav" aria-label="Instagram navigation">
    <ul class="nav-list">
      <li>
        <a href="/admin/instagram/dashboard" class="nav-item-link <%= currentSection === 'dashboard' ? 'active' : '' %>" <%- currentSection === 'dashboard' ? 'aria-current="page"' : '' %>>
          <span>📊</span> Dashboard
        </a>
      </li>
      <li>
        <a href="/admin/instagram/reels" class="nav-item-link <%= currentSection === 'rules' || currentSection === 'reels' || currentSection === 'new_reel' ? 'active' : '' %>" <%- (currentSection === 'rules' || currentSection === 'reels' || currentSection === 'new_reel') ? 'aria-current="page"' : '' %>>
          <span>🎬</span> Reels
        </a>
      </li>
      <li>
        <a href="/admin/instagram/activity" class="nav-item-link <%= currentSection === 'activity' ? 'active' : '' %>" <%- currentSection === 'activity' ? 'aria-current="page"' : '' %>>
          <span>📋</span> Activity
        </a>
      </li>
      <li>
        <a href="/admin/instagram/settings" class="nav-item-link <%= currentSection === 'settings' ? 'active' : '' %>" <%- currentSection === 'settings' ? 'aria-current="page"' : '' %>>
          <span>⚙️</span> Settings
        </a>
      </li>
    </ul>
  </nav>

  <nav class="mobile-tab-bar" aria-label="Instagram mobile navigation">
    <a href="/admin/instagram/dashboard" class="tab-link <%= currentSection === 'dashboard' ? 'active' : '' %>" <%- currentSection === 'dashboard' ? 'aria-current="page"' : '' %>>
      <span style="font-size: 18px;">📊</span>
      <span>Dashboard</span>
    </a>
    <a href="/admin/instagram/reels" class="tab-link <%= currentSection === 'rules' || currentSection === 'reels' || currentSection === 'new_reel' ? 'active' : '' %>" <%- (currentSection === 'rules' || currentSection === 'reels' || currentSection === 'new_reel') ? 'aria-current="page"' : '' %>>
      <span style="font-size: 18px;">🎬</span>
      <span>Reels</span>
    </a>
    <a href="/admin/instagram/activity" class="tab-link <%= currentSection === 'activity' ? 'active' : '' %>" <%- currentSection === 'activity' ? 'aria-current="page"' : '' %>>
      <span style="font-size: 18px;">📋</span>
      <span>Activity</span>
    </a>
    <a href="/admin/instagram/settings" class="tab-link <%= currentSection === 'settings' ? 'active' : '' %>" <%- currentSection === 'settings' ? 'aria-current="page"' : '' %>>
      <span style="font-size: 18px;">⚙️</span>
      <span>Settings</span>
    </a>
  </nav>
<% } else if (currentPlatform === 'youtube') { %>
  <nav class="desktop-nav" aria-label="YouTube navigation">
    <ul class="nav-list">
      <li>
        <a href="/admin/youtube" class="nav-item-link <%= currentSection === 'dashboard' ? 'active' : '' %>" <%- currentSection === 'dashboard' ? 'aria-current="page"' : '' %>>
          <span>📊</span> Dashboard
        </a>
      </li>
      <li>
        <a href="/admin/youtube/videos" class="nav-item-link <%= currentSection === 'rules' || currentSection === 'videos' ? 'active' : '' %>" <%- (currentSection === 'rules' || currentSection === 'videos') ? 'aria-current="page"' : '' %>>
          <span>▶️</span> Videos
        </a>
      </li>
      <li>
        <a href="/admin/youtube/activity" class="nav-item-link <%= currentSection === 'activity' ? 'active' : '' %>" <%- currentSection === 'activity' ? 'aria-current="page"' : '' %>>
          <span>📋</span> Activity
        </a>
      </li>
      <li>
        <a href="/admin/youtube/settings" class="nav-item-link <%= currentSection === 'settings' ? 'active' : '' %>" <%- currentSection === 'settings' ? 'aria-current="page"' : '' %>>
          <span>⚙️</span> Settings
        </a>
      </li>
    </ul>
  </nav>

  <nav class="mobile-tab-bar" aria-label="YouTube mobile navigation">
    <a href="/admin/youtube" class="tab-link <%= currentSection === 'dashboard' ? 'active' : '' %>" <%- currentSection === 'dashboard' ? 'aria-current="page"' : '' %>>
      <span style="font-size: 18px;">📊</span>
      <span>Dashboard</span>
    </a>
    <a href="/admin/youtube/videos" class="tab-link <%= currentSection === 'rules' || currentSection === 'videos' ? 'active' : '' %>" <%- (currentSection === 'rules' || currentSection === 'videos') ? 'aria-current="page"' : '' %>>
      <span style="font-size: 18px;">▶️</span>
      <span>Videos</span>
    </a>
    <a href="/admin/youtube/activity" class="tab-link <%= currentSection === 'activity' ? 'active' : '' %>" <%- currentSection === 'activity' ? 'aria-current="page"' : '' %>>
      <span style="font-size: 18px;">📋</span>
      <span>Activity</span>
    </a>
    <a href="/admin/youtube/settings" class="tab-link <%= currentSection === 'settings' ? 'active' : '' %>" <%- currentSection === 'settings' ? 'aria-current="page"' : '' %>>
      <span style="font-size: 18px;">⚙️</span>
      <span>Settings</span>
    </a>
  </nav>
<% } %>
