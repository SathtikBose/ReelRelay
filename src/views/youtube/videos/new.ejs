<%- include('../../partials/header') %>

<div style="margin-bottom: 24px;">
  <a href="/admin/youtube/videos" style="font-size: 14px; color: var(--muted); display: inline-flex; align-items: center; gap: 4px; margin-bottom: 8px; text-decoration: none;">
    ← Back to Video Rules
  </a>
  <h1 style="font-size: 24px; font-weight: 700;">New YouTube Video Rule</h1>
  <p style="color: var(--muted); font-size: 14px;">
    Configure automated public replies for viewer comments using specific keywords
  </p>
</div>

<form action="/admin/youtube/videos" method="POST" id="rule-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  
  <!-- Hidden fields for picker metadata -->
  <input type="hidden" id="video-title-input" name="title" value="<%= prefill.title || '' %>">
  <input type="hidden" id="thumbnail-url-input" name="thumbnailUrl" value="<%= prefill.thumbnailUrl || '' %>">
  <input type="hidden" id="published-at-input" name="publishedAt" value="">
  <input type="hidden" id="is-short-input" name="isShort" value="">

  <!-- Step 1: Video Selection -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">1. Select YouTube Video or Short</h2>
    </div>

    <% if (ytStatus && ytStatus.connected) { %>
      <div style="margin-bottom: 16px;">
        <button type="button" id="load-picker-btn" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 6px;">
          <span>▶️</span> Select from Recent Uploads
        </button>
        <div id="picker-loading" style="display:none; margin-top: 10px; font-size: 14px; color: var(--muted);">
          Loading recent uploads from YouTube...
        </div>
        <div id="picker-error" style="display:none; margin-top: 10px; color: var(--danger); font-size: 13px;"></div>
        
        <div id="picker-container" style="display:none; margin-top: 14px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--card-radius); padding: 16px;">
          <div style="margin-bottom: 12px; display: flex; gap: 8px;">
            <input type="text" id="picker-search" class="form-input" placeholder="Filter uploads by title..." style="font-size: 13px;">
            <button type="button" id="picker-refresh-btn" class="btn btn-secondary btn-sm" title="Refresh from YouTube API">🔄</button>
          </div>
          <div id="picker-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; max-height: 360px; overflow-y: auto; padding-right: 4px;"></div>
        </div>
      </div>
    <% } %>

    <div class="form-group">
      <label for="video-id-input" class="form-label">YouTube Video URL or 11-Character ID</label>
      <input 
        type="text" 
        id="video-id-input" 
        name="videoId" 
        class="form-input" 
        value="<%= prefill.videoId || '' %>" 
        required 
        placeholder="e.g. https://www.youtube.com/watch?v=dQw4w9WgXcQ or dQw4w9WgXcQ"
      >
      <div class="form-hint">Supports full URLs (watch, youtu.be, shorts) or raw 11-character video IDs.</div>
    </div>
  </div>

  <!-- Step 2: Keywords & Match Mode -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">2. Trigger Keywords & Match Mode</h2>
    </div>

    <div class="form-group">
      <label for="keyword-chip-input" class="form-label">Trigger Keywords (Max 10)</label>
      <div class="chip-container" id="keyword-chips-container" style="display: flex; flex-wrap: wrap; gap: 6px; padding: 6px; border: 1px solid var(--border); border-radius: var(--input-radius); background: var(--input-bg);">
        <input 
          type="text" 
          id="keyword-chip-input" 
          class="chip-input" 
          placeholder="Type keyword and press Enter or comma..." 
          autocomplete="off"
          style="border: none; outline: none; background: transparent; flex: 1; min-width: 160px; padding: 4px; font-size: 14px; color: var(--text);"
        >
      </div>
      <input 
        type="hidden" 
        id="keywords-hidden" 
        name="keywords" 
        value="<%= prefill.keywords || '' %>"
      >
      <div class="form-hint">Case-insensitive. Commas or Enter separate keywords.</div>
    </div>

    <div class="form-group">
      <label class="form-label">Match Mode</label>
      <div class="segmented-control" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <label class="segment-option <%= (prefill.matchMode || 'word') === 'word' ? 'active' : '' %>" style="display: flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid var(--border); border-radius: var(--input-radius); cursor: pointer;">
          <input type="radio" name="matchMode" value="word" <%= (prefill.matchMode || 'word') === 'word' ? 'checked' : '' %>>
          <span><strong>Whole word</strong> (e.g. "link" in "send me the link")</span>
        </label>
        <label class="segment-option <%= prefill.matchMode === 'exact' ? 'active' : '' %>" style="display: flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid var(--border); border-radius: var(--input-radius); cursor: pointer;">
          <input type="radio" name="matchMode" value="exact" <%= prefill.matchMode === 'exact' ? 'checked' : '' %>>
          <span><strong>Exact comment</strong> (comment must match keyword exactly)</span>
        </label>
        <label class="segment-option <%= prefill.matchMode === 'contains' ? 'active' : '' %>" style="display: flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid var(--border); border-radius: var(--input-radius); cursor: pointer;">
          <input type="radio" name="matchMode" value="contains" <%= prefill.matchMode === 'contains' ? 'checked' : '' %>>
          <span><strong>Contains</strong> (substring match)</span>
        </label>
      </div>
    </div>
  </div>

  <!-- Step 3: Destination Link -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">3. Destination Link</h2>
    </div>

    <div class="form-group">
      <label for="link-input" class="form-label">HTTPS Destination URL</label>
      <div style="display: flex; gap: 8px;">
        <input 
          type="url" 
          id="link-input" 
          name="link" 
          class="form-input" 
          value="<%= prefill.link || '' %>" 
          required 
          placeholder="https://example.com/my-resource" 
          style="flex: 1;"
        >
        <button type="button" id="test-link-btn" class="btn btn-secondary" style="white-space: nowrap;">
          Test Link ↗
        </button>
      </div>
      <div class="form-hint" style="color: var(--muted); margin-top: 6px;">
        💡 <em>Note: YouTube may hold replies containing links for review based on channel community settings. Test with a secondary account.</em>
      </div>
    </div>
  </div>

  <!-- Step 4: Reply Variants & Preview -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">4. Reply Variants (Randomized)</h2>
      <button type="button" id="add-variant-btn" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 4px;">
        + Add Variant
      </button>
    </div>

    <p style="color: var(--muted); font-size: 13px; margin-bottom: 12px;">
      ReelRelay picks a variant at random so replies are not identical. Use variable tags to personalize replies:
    </p>

    <div style="display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap;">
      <button type="button" class="btn btn-secondary btn-sm var-tag-btn" data-tag="{{link}}" style="font-family: monospace; font-size: 12px;">{{link}}</button>
      <button type="button" class="btn btn-secondary btn-sm var-tag-btn" data-tag="{{author}}" style="font-family: monospace; font-size: 12px;">{{author}}</button>
      <button type="button" class="btn btn-secondary btn-sm var-tag-btn" data-tag="{{keyword}}" style="font-family: monospace; font-size: 12px;">{{keyword}}</button>
    </div>

    <div id="variants-container" style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px;">
      <% (prefill.replyVariants || []).forEach(function(variant, index) { %>
        <div class="variant-row" style="display: flex; gap: 8px; align-items: flex-start;">
          <textarea 
            name="replyVariants" 
            class="form-input variant-textarea" 
            rows="2" 
            maxlength="500" 
            placeholder="Reply message..."
            style="flex: 1; resize: vertical;"
          ><%= variant %></textarea>
          <% if (index > 0) { %>
            <button type="button" class="btn btn-secondary btn-sm remove-variant-btn" style="color: var(--danger); margin-top: 4px;">✕</button>
          <% } %>
        </div>
      <% }); %>
    </div>

    <!-- Live Preview Bubble -->
    <div style="background: var(--bg); border: 1px solid var(--border); border-radius: var(--card-radius); padding: 14px;">
      <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; letter-spacing: 0.5px;">
        YouTube Reply Live Preview
      </div>
      <div style="display: flex; gap: 10px; align-items: flex-start;">
        <div style="width: 28px; height: 28px; border-radius: 50%; background: #E11D48; color: white; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: bold; flex-shrink: 0;">
          ▶
        </div>
        <div style="flex: 1; min-width: 0;">
          <div style="font-size: 12px; font-weight: 600; margin-bottom: 2px;">
            <%= ytStatus && ytStatus.channelTitle ? ytStatus.channelTitle : 'Your Channel' %>
            <span style="font-size: 11px; color: var(--muted); font-weight: normal; margin-left: 6px;">Just now</span>
          </div>
          <div id="reply-preview-text" style="font-size: 13px; color: var(--text); line-height: 1.4; word-break: break-word;">
            Here you go 👉 <span style="color: var(--primary);">https://example.com/my-resource</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 5: Backfill Option -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">5. Historical Comments (Backfill)</h2>
    </div>

    <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
      <input type="checkbox" name="backfill" id="backfill-checkbox" value="true" style="margin-top: 3px;">
      <div>
        <span style="font-weight: 600; font-size: 14px;">Also reply to existing comments from the last 7 days</span>
        <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">
          By default, ReelRelay only replies to new comments made <strong>after</strong> this rule is created. Check this to scan up to 7 days of past comments (uses more quota).
        </div>
      </div>
    </label>
  </div>

  <!-- Form Actions -->
  <div style="display: flex; gap: 12px; margin-top: 24px;">
    <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">
      Create Video Rule
    </button>
    <a href="/admin/youtube/videos" class="btn btn-secondary" style="text-decoration: none; padding: 10px 20px;">
      Cancel
    </a>
  </div>
</form>

<script>
  // Keyword Chips Management
  (function() {
    const container = document.getElementById('keyword-chips-container');
    const chipInput = document.getElementById('keyword-chip-input');
    const hiddenInput = document.getElementById('keywords-hidden');
    let keywords = hiddenInput.value ? hiddenInput.value.split(',').map(s => s.trim().toLowerCase()).filter(Boolean) : [];

    function renderChips() {
      container.querySelectorAll('.chip-item').forEach(el => el.remove());
      keywords.forEach((kw, index) => {
        const chip = document.createElement('span');
        chip.className = 'chip-item';
        chip.style.cssText = 'display:inline-flex;align-items:center;gap:4px;background:var(--card-bg);border:1px solid var(--border);border-radius:12px;padding:2px 8px;font-size:12px;font-weight:500;';
        chip.innerHTML = kw + '<button type="button" style="border:none;background:transparent;cursor:pointer;color:var(--muted);font-size:12px;padding:0 2px;">✕</button>';
        chip.querySelector('button').addEventListener('click', () => {
          keywords.splice(index, 1);
          sync();
        });
        container.insertBefore(chip, chipInput);
      });
    }

    function sync() {
      hiddenInput.value = keywords.join(',');
      renderChips();
    }

    chipInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ',') {
        e.preventDefault();
        const val = chipInput.value.trim().toLowerCase();
        if (val && !keywords.includes(val) && keywords.length < 10) {
          keywords.push(val);
          chipInput.value = '';
          sync();
        }
      } else if (e.key === 'Backspace' && !chipInput.value && keywords.length > 0) {
        keywords.pop();
        sync();
      }
    });

    renderChips();

    // Test Link Button
    const linkInput = document.getElementById('link-input');
    const testLinkBtn = document.getElementById('test-link-btn');
    testLinkBtn.addEventListener('click', () => {
      const url = linkInput.value.trim();
      if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
        window.open(url, '_blank', 'noopener,noreferrer');
      } else {
        alert('Please enter a valid destination URL starting with https://');
      }
    });

    // Reply Preview Live Sync
    const previewText = document.getElementById('reply-preview-text');
    function updatePreview() {
      const firstTextarea = document.querySelector('.variant-textarea');
      const text = firstTextarea ? firstTextarea.value : 'Here you go 👉 {{link}}';
      const link = linkInput.value.trim() || 'https://example.com/my-resource';
      const sample = text
        .replace(/\{\{link\}\}/g, link)
        .replace(/\{\{author\}\}/g, '@Viewer')
        .replace(/\{\{keyword\}\}/g, keywords[0] || 'link');
      previewText.innerHTML = sample.replace(/(https?:\/\/[^\s]+)/g, '<span style="color:var(--primary);">$1</span>');
    }

    document.addEventListener('input', (e) => {
      if (e.target.classList.contains('variant-textarea') || e.target.id === 'link-input') {
        updatePreview();
      }
    });

    // Add Variant Button
    const addVarBtn = document.getElementById('add-variant-btn');
    const varContainer = document.getElementById('variants-container');
    addVarBtn.addEventListener('click', () => {
      const count = varContainer.querySelectorAll('.variant-row').length;
      if (count >= 5) {
        alert('Maximum of 5 reply variants allowed.');
        return;
      }
      const row = document.createElement('div');
      row.className = 'variant-row';
      row.style.cssText = 'display:flex;gap:8px;align-items:flex-start;';
      row.innerHTML = '<textarea name="replyVariants" class="form-input variant-textarea" rows="2" maxlength="500" placeholder="Reply message..." style="flex:1;resize:vertical;"></textarea><button type="button" class="btn btn-secondary btn-sm remove-variant-btn" style="color:var(--danger);margin-top:4px;">✕</button>';
      row.querySelector('.remove-variant-btn').addEventListener('click', () => row.remove());
      varContainer.appendChild(row);
    });

    varContainer.addEventListener('click', (e) => {
      if (e.target.classList.contains('remove-variant-btn')) {
        e.target.closest('.variant-row').remove();
        updatePreview();
      }
    });

    // Tag Insertion Buttons
    document.querySelectorAll('.var-tag-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag;
        const activeTextarea = document.activeElement && document.activeElement.classList.contains('variant-textarea') 
          ? document.activeElement 
          : document.querySelector('.variant-textarea');
        if (activeTextarea) {
          const start = activeTextarea.selectionStart;
          const end = activeTextarea.selectionEnd;
          const text = activeTextarea.value;
          activeTextarea.value = text.substring(0, start) + tag + text.substring(end);
          activeTextarea.selectionStart = activeTextarea.selectionEnd = start + tag.length;
          activeTextarea.focus();
          updatePreview();
        }
      });
    });

    // Video Picker Ajax Logic
    const loadPickerBtn = document.getElementById('load-picker-btn');
    if (loadPickerBtn) {
      const pickerContainer = document.getElementById('picker-container');
      const pickerGrid = document.getElementById('picker-grid');
      const pickerLoading = document.getElementById('picker-loading');
      const pickerError = document.getElementById('picker-error');
      const pickerSearch = document.getElementById('picker-search');
      let allVideos = [];

      async function fetchVideos(refresh = false) {
        pickerLoading.style.display = 'block';
        pickerError.style.display = 'none';
        pickerGrid.innerHTML = '';
        try {
          const res = await fetch('/admin/youtube/api/videos' + (refresh ? '?refresh=true' : ''));
          const data = await res.json();
          pickerLoading.style.display = 'none';
          if (!res.ok || data.error) {
            pickerError.textContent = data.error?.message || 'Failed to load videos from YouTube';
            pickerError.style.display = 'block';
            return;
          }
          allVideos = data.data || [];
          renderPickerGrid(allVideos);
          pickerContainer.style.display = 'block';
        } catch (err) {
          pickerLoading.style.display = 'none';
          pickerError.textContent = err.message || 'Error connecting to server';
          pickerError.style.display = 'block';
        }
      }

      function renderPickerGrid(videos) {
        pickerGrid.innerHTML = '';
        if (videos.length === 0) {
          pickerGrid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--muted);padding:20px;">No videos found.</div>';
          return;
        }

        videos.forEach(v => {
          const card = document.createElement('div');
          card.style.cssText = 'background:var(--card-bg);border:1px solid var(--border);border-radius:4px;padding:8px;cursor:' + (v.hasRule ? 'not-allowed;' : 'pointer;') + ';opacity:' + (v.hasRule ? '0.6;' : '1;');
          
          card.innerHTML = 
            '<div style="position:relative;margin-bottom:6px;">' +
              '<img src="' + (v.thumbnailUrl || '') + '" style="width:100%;height:100px;object-fit:cover;border-radius:2px;background:#000;" alt="">' +
              (v.isShort ? '<span style="position:absolute;top:4px;left:4px;background:#E11D48;color:#fff;font-size:10px;font-weight:bold;padding:1px 4px;border-radius:2px;">SHORT</span>' : '') +
              (v.hasRule ? '<span style="position:absolute;bottom:4px;right:4px;background:rgba(0,0,0,0.8);color:#fff;font-size:10px;padding:2px 6px;border-radius:2px;">Has Rule</span>' : '') +
            '</div>' +
            '<div style="font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="' + (v.title || '') + '">' + (v.title || 'Untitled') + '</div>' +
            '<div style="font-size:11px;color:var(--muted);margin-top:2px;">' + new Date(v.publishedAt).toLocaleDateString() + '</div>';

          if (!v.hasRule) {
            card.addEventListener('click', () => {
              document.getElementById('video-id-input').value = v.videoId;
              document.getElementById('video-title-input').value = v.title;
              document.getElementById('thumbnail-url-input').value = v.thumbnailUrl;
              document.getElementById('published-at-input').value = v.publishedAt;
              document.getElementById('is-short-input').value = v.isShort ? 'true' : 'false';
              pickerContainer.style.display = 'none';
            });
          }

          pickerGrid.appendChild(card);
        });
      }

      loadPickerBtn.addEventListener('click', () => fetchVideos(false));
      document.getElementById('picker-refresh-btn').addEventListener('click', () => fetchVideos(true));
      pickerSearch.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        const filtered = allVideos.filter(v => (v.title || '').toLowerCase().includes(query));
        renderPickerGrid(filtered);
      });
    }

    updatePreview();
  })();
</script>

<%- include('../../partials/footer') %>
