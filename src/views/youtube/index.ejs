<%- include('../partials/header') %>

<% if (!ytStatus || !ytStatus.connected) { %>
  <!-- Not Connected State -->
  <div class="youtube-connect-container" style="max-width: 680px; margin: 0 auto; padding-top: 10px;">
    <% if (ytStatus && ytStatus.status === 'needs_reauth') { %>
      <div style="background-color: rgba(220, 38, 38, 0.1); border: 1px solid var(--danger); color: var(--danger); padding: 14px 18px; border-radius: var(--input-radius); margin-bottom: 20px; font-size: 14px; display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 18px;">⚠️</span>
        <div>
          <strong>Re-authentication Required:</strong> <%= ytStatus.lastError || 'Your YouTube connection has expired or was revoked.' %>
        </div>
      </div>
    <% } %>

    <div class="card" style="text-align: center; padding: 40px 24px;">
      <div style="font-size: 48px; margin-bottom: 16px;">▶️</div>
      <h1 style="font-size: 24px; font-weight: 700; margin-bottom: 12px; color: var(--text);">
        Connect YouTube Channel
      </h1>
      <p style="color: var(--muted); font-size: 15px; line-height: 1.6; margin-bottom: 24px;">
        ReelRelay replies automatically to viewer comments on your YouTube videos and Shorts when they use your trigger keywords.
      </p>

      <div style="background-color: var(--bg); border: 1px solid var(--border); border-radius: var(--card-radius); padding: 20px; text-align: left; margin-bottom: 28px;">
        <h3 style="font-size: 14px; font-weight: 600; margin-bottom: 12px; color: var(--text);">
          Permissions & Security:
        </h3>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: var(--muted);">
          <li style="display: flex; align-items: flex-start; gap: 8px;">
            <span style="color: var(--success); font-weight: bold;">✓</span>
            <span><strong>Encrypted Storage:</strong> Refresh tokens are AES-256-GCM encrypted and access tokens stay in memory.</span>
          </li>
          <li style="display: flex; align-items: flex-start; gap: 8px;">
            <span style="color: var(--success); font-weight: bold;">✓</span>
            <span><strong>Minimal Permissions:</strong> Only requests permission to view your channel details and post replies.</span>
          </li>
          <li style="display: flex; align-items: flex-start; gap: 8px;">
            <span style="color: var(--success); font-weight: bold;">✓</span>
            <span><strong>PKCE & State Protected:</strong> RFC 7636 Proof Key for Code Exchange secures the authorization flow.</span>
          </li>
        </ul>
      </div>

      <% if (ytStatus && !ytStatus.configured) { %>
        <div style="background: rgba(217, 119, 6, 0.1); border: 1px solid var(--warning); color: var(--warning); padding: 12px 16px; border-radius: var(--input-radius); margin-bottom: 20px; font-size: 13px; text-align: left;">
          <strong>Configuration Notice:</strong> Google OAuth credentials (<code>GOOGLE_CLIENT_ID</code> / <code>GOOGLE_CLIENT_SECRET</code>) are not configured in your <code>.env</code> file. Please configure them in Google Cloud Console first.
        </div>
      <% } %>

      <div style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
        <a href="/admin/youtube/oauth/start" class="btn btn-primary" style="padding: 12px 32px; font-size: 15px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
          <span>▶️</span> Connect YouTube with Google
        </a>
      </div>
    </div>
  </div>

<% } else { %>
  <!-- Connected Dashboard State -->
  <% if (alerts && alerts.length > 0) { %>
    <div style="margin-bottom: 20px; display: flex; flex-direction: column; gap: 10px;">
      <% alerts.forEach(function(alert) { %>
        <div style="background-color: <%= alert.type === 'danger' ? 'rgba(220, 38, 38, 0.1)' : (alert.type === 'warning' ? 'rgba(217, 119, 6, 0.1)' : 'rgba(59, 130, 246, 0.1)') %>; border: 1px solid <%= alert.type === 'danger' ? 'var(--danger)' : (alert.type === 'warning' ? 'var(--warning)' : '#3B82F6') %>; color: <%= alert.type === 'danger' ? 'var(--danger)' : (alert.type === 'warning' ? 'var(--warning)' : '#3B82F6') %>; padding: 12px 16px; border-radius: var(--input-radius); font-size: 14px; display: flex; align-items: center; gap: 10px;">
          <span><%= alert.type === 'danger' ? '🚨' : (alert.type === 'warning' ? '⚠️' : 'ℹ️') %></span>
          <div><%= alert.message %></div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
    <div>
      <h1 style="font-size: 24px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
        <span>YouTube Dashboard</span>
        <span class="badge badge-active">Connected</span>
      </h1>
      <p style="color: var(--muted); font-size: 14px;">Automated comment replies for <strong><%= ytStatus.channelTitle %></strong> (<span style="font-family: monospace; font-size: 12px;"><%= ytStatus.channelId %></span>)</p>
    </div>

    <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
      <form action="/admin/youtube/poll-now" method="POST" style="margin: 0;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-primary btn-sm" id="poll-now-btn">
          ⚡ Poll Now
        </button>
      </form>
      <a href="/admin/youtube/videos/new" class="btn btn-secondary btn-sm">
        + New Video Rule
      </a>
      <form action="/admin/youtube/disconnect" method="POST" style="margin: 0;" data-confirm="Are you sure you want to disconnect this YouTube channel? Automated replies will stop.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger);">
          Disconnect Channel
        </button>
      </form>
    </div>
  </div>

  <!-- YouTube Dashboard Stats Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <div class="card" style="margin-bottom: 0; padding: 16px;">
      <div style="font-size: 13px; color: var(--muted); margin-bottom: 4px;">Replies Today</div>
      <div style="font-size: 28px; font-weight: 700; color: var(--success);"><%= stats ? stats.repliedToday : 0 %></div>
      <div style="font-size: 11px; color: var(--muted); margin-top: 4px;"><%= stats ? stats.replied7Days : 0 %> in last 7 days</div>
    </div>

    <div class="card" style="margin-bottom: 0; padding: 16px;">
      <div style="font-size: 13px; color: var(--muted); margin-bottom: 4px;">Active Video Rules</div>
      <div style="font-size: 28px; font-weight: 700; color: var(--text);">
        <a href="/admin/youtube/videos" style="text-decoration: none; color: inherit;">
          <%= stats ? stats.activeRules : 0 %> <span style="font-size: 14px; font-weight: normal; color: var(--muted);">/ <%= stats ? stats.totalRules : 0 %></span>
        </a>
      </div>
      <div style="font-size: 11px; color: var(--muted); margin-top: 4px;">
        <a href="/admin/youtube/videos" style="color: var(--primary); text-decoration: none;">Manage rules →</a>
      </div>
    </div>

    <div class="card" style="margin-bottom: 0; padding: 16px;">
      <div style="font-size: 13px; color: var(--muted); margin-bottom: 4px;">Failed / Deferred</div>
      <div style="font-size: 28px; font-weight: 700; color: <%= (stats && (stats.failedTotal + stats.deferredTotal) > 0) ? 'var(--warning)' : 'var(--text)' %>;">
        <%= stats ? stats.failedTotal : 0 %> <span style="font-size: 14px; font-weight: normal; color: var(--muted);">/ <%= stats ? stats.deferredTotal : 0 %> def</span>
      </div>
      <div style="font-size: 11px; color: var(--muted); margin-top: 4px;">
        <a href="/admin/youtube/activity?status=failed" style="color: var(--primary); text-decoration: none;">View failed →</a>
      </div>
    </div>

    <div class="card" style="margin-bottom: 0; padding: 16px;">
      <div style="font-size: 13px; color: var(--muted); margin-bottom: 4px;">Quota Used Today</div>
      <div style="font-size: 20px; font-weight: 700; color: var(--primary);">
        <%= quotaStatus ? quotaStatus.quotaUsed : 0 %> / <%= quotaStatus ? quotaStatus.quotaBudget.toLocaleString() : '9,000' %>
      </div>
      <div style="font-size: 11px; color: var(--muted); margin-top: 4px;">
        Resets at midnight Pacific
      </div>
    </div>
  </div>

  <!-- Quota Meter & Polling Engine Status Row -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <!-- Quota Meter Card -->
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header">
        <h2 class="card-title">YouTube API Quota Meter</h2>
        <% const quotaPercent = quotaStatus ? Math.min(100, Math.round((quotaStatus.quotaUsed / quotaStatus.quotaBudget) * 100)) : 0; %>
        <span class="badge <%= quotaPercent > 90 ? 'badge-paused' : (quotaPercent > 70 ? 'badge-paused' : 'badge-active') %>">
          <%= quotaPercent %>% used
        </span>
      </div>

      <div style="margin-bottom: 12px;">
        <div style="background-color: var(--bg); height: 12px; border-radius: 6px; overflow: hidden; border: 1px solid var(--border);">
          <div style="width: <%= quotaPercent %>%; height: 100%; background-color: <%= quotaPercent > 90 ? 'var(--danger)' : (quotaPercent > 70 ? 'var(--warning)' : 'var(--primary)') %>; transition: width 0.3s ease;"></div>
        </div>
      </div>

      <div style="display: flex; justify-content: space-between; font-size: 12px; color: var(--muted);">
        <span><%= quotaStatus ? quotaStatus.quotaUsed : 0 %> units used</span>
        <span>Budget: <%= (quotaStatus && quotaStatus.quotaBudget ? quotaStatus.quotaBudget : 9000).toLocaleString() %> / 10,000 total</span>
      </div>
    </div>

    <!-- Poller Status Card -->
    <div class="card" style="margin-bottom: 0;">
      <div class="card-header">
        <h2 class="card-title">Background Poller Status</h2>
        <span class="badge <%= lastPoll && lastPoll.status === 'ok' ? 'badge-active' : (lastPoll && lastPoll.status === 'error' ? 'badge-paused' : 'badge-active') %>">
          <%= lastPoll ? lastPoll.status.toUpperCase() : 'IDLE' %>
        </span>
      </div>

      <div style="font-size: 13px; color: var(--muted); margin-bottom: 8px;">
        <strong>Last Poll Time:</strong>
        <%= lastPoll && lastPoll.at ? new Date(lastPoll.at).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' }) : 'Pending first cycle' %>
      </div>

      <% if (lastPoll && lastPoll.summary) { %>
        <div style="display: flex; gap: 12px; font-size: 12px; color: var(--muted); background-color: var(--bg); padding: 8px 12px; border-radius: var(--input-radius);">
          <span>Rules: <strong><%= lastPoll.summary.rules || 0 %></strong></span>
          <span>Comments: <strong><%= lastPoll.summary.comments || 0 %></strong></span>
          <span>Replies: <strong><%= lastPoll.summary.replies || 0 %></strong></span>
          <span>Errors: <strong style="color: <%= (lastPoll.summary.errors || 0) > 0 ? 'var(--danger)' : 'inherit' %>;"><%= lastPoll.summary.errors || 0 %></strong></span>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Recent YouTube Activity Table -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Recent YouTube Activity</h2>
      <a href="/admin/youtube/activity" class="btn btn-secondary btn-sm">View Full Log →</a>
    </div>

    <% if (!recentActivity || recentActivity.length === 0) { %>
      <div class="empty-state" style="padding: 24px 16px;">
        <p>No comment replies recorded yet. Once viewers comment on your active videos, replies will appear here.</p>
      </div>
    <% } else { %>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 14px; text-align: left;">
          <thead>
            <tr style="border-bottom: 1px solid var(--border); color: var(--muted); font-size: 12px;">
              <th style="padding: 8px 12px;">Time</th>
              <th style="padding: 8px 12px;">Author</th>
              <th style="padding: 8px 12px;">Comment</th>
              <th style="padding: 8px 12px;">Keyword</th>
              <th style="padding: 8px 12px;">Status</th>
            </tr>
          </thead>
          <tbody>
            <% recentActivity.forEach(function(item) { %>
              <tr style="border-bottom: 1px solid var(--border);">
                <td style="padding: 10px 12px; color: var(--muted); white-space: nowrap; font-size: 13px;">
                  <%= new Date(item.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                </td>
                <td style="padding: 10px 12px; font-weight: 500;">
                  <%= item.authorName || 'Viewer' %>
                </td>
                <td style="padding: 10px 12px; max-width: 260px;">
                  <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    <%= item.commentText %>
                  </div>
                </td>
                <td style="padding: 10px 12px;">
                  <% if (item.matchedKeyword) { %>
                    <span class="chip" style="font-size: 11px; padding: 2px 8px;"><%= item.matchedKeyword %></span>
                  <% } else { %>
                    <span style="color: var(--muted); font-size: 12px;">—</span>
                  <% } %>
                </td>
                <td style="padding: 10px 12px;">
                  <% if (item.status === 'posted') { %>
                    <span class="badge badge-active">Posted</span>
                  <% } else if (item.status === 'failed') { %>
                    <span class="badge" style="background-color: rgba(220, 38, 38, 0.15); color: var(--danger);">Failed</span>
                  <% } else if (item.status === 'deferred') { %>
                    <span class="badge" style="background-color: rgba(217, 119, 6, 0.15); color: var(--warning);">Deferred</span>
                  <% } else { %>
                    <span class="badge badge-paused"><%= item.status %></span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
<% } %>

<%- include('../partials/footer') %>
