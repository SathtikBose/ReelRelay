<%- include('../partials/header') %>

<div class="overview-header" style="margin-bottom: 24px;">
  <h1 style="font-size: 24px; font-weight: 700; color: var(--text); margin-bottom: 4px;">Platform Overview</h1>
  <p style="color: var(--muted); font-size: 14px;">Monitor and manage your automated comment replies across all connected platforms.</p>
</div>

<!-- Platforms Grid -->
<div class="overview-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 32px;">
  <!-- Instagram Platform Card -->
  <div class="card platform-card" style="margin-bottom: 0; display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <div class="card-header" style="border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 24px;">📸</span>
          <div>
            <h2 class="card-title" style="margin: 0; font-size: 18px;">Instagram</h2>
            <span class="badge badge-active" style="margin-top: 2px;">
              <span class="status-dot" style="margin-right: 4px;"></span> Active
            </span>
          </div>
        </div>
        <a href="/admin/instagram/dashboard" class="btn btn-secondary btn-sm">Open Dashboard →</a>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
        <div style="background-color: var(--bg); padding: 12px; border-radius: var(--input-radius);">
          <div style="font-size: 12px; color: var(--muted);">DMs Sent (7d)</div>
          <div style="font-size: 20px; font-weight: 700; color: var(--text);"><%= instagram.stats.sent7Days %></div>
        </div>
        <div style="background-color: var(--bg); padding: 12px; border-radius: var(--input-radius);">
          <div style="font-size: 12px; color: var(--muted);">Failed Total</div>
          <div style="font-size: 20px; font-weight: 700; color: <%= instagram.stats.failedTotal > 0 ? 'var(--danger)' : 'var(--text)' %>;"><%= instagram.stats.failedTotal %></div>
        </div>
        <div style="background-color: var(--bg); padding: 12px; border-radius: var(--input-radius);">
          <div style="font-size: 12px; color: var(--muted);">Active Rules</div>
          <div style="font-size: 20px; font-weight: 700; color: var(--text);"><%= instagram.stats.activeRules %></div>
        </div>
        <div style="background-color: var(--bg); padding: 12px; border-radius: var(--input-radius);">
          <div style="font-size: 12px; color: var(--muted);">Token Status</div>
          <div style="font-size: 15px; font-weight: 600; color: <%= instagram.tokenStatus.isExpired ? 'var(--danger)' : 'var(--success)' %>;">
            <%= instagram.tokenStatus.isExpired ? 'Expired' : (instagram.tokenStatus.daysLeft !== null ? `${instagram.tokenStatus.daysLeft}d left` : 'Active') %>
          </div>
        </div>
      </div>
    </div>

    <div style="border-top: 1px solid var(--border); padding-top: 12px; display: flex; gap: 8px; justify-content: flex-end;">
      <a href="/admin/instagram/reels" class="btn btn-secondary btn-sm">Manage Reels</a>
      <a href="/admin/instagram/activity" class="btn btn-secondary btn-sm">Activity Log</a>
    </div>
  </div>

  <!-- YouTube Platform Card -->
  <div class="card platform-card" style="margin-bottom: 0; display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <div class="card-header" style="border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 24px;">▶️</span>
          <div>
            <h2 class="card-title" style="margin: 0; font-size: 18px;">YouTube</h2>
            <span class="badge" style="background-color: rgba(107, 112, 128, 0.15); color: var(--muted); margin-top: 2px;">
              Not connected
            </span>
          </div>
        </div>
        <a href="/admin/youtube" class="btn btn-primary btn-sm">Connect YouTube</a>
      </div>

      <div style="padding: 20px; background-color: var(--bg); border-radius: var(--input-radius); text-align: center; margin-bottom: 16px;">
        <p style="font-size: 14px; color: var(--muted); margin-bottom: 12px;">
          Automatically reply to viewer comments on YouTube videos and Shorts with links and personalized messages.
        </p>
        <span class="badge" style="background-color: rgba(225, 29, 72, 0.12); color: #E11D48; font-weight: 600;">
          Coming in Phase Y2 (OAuth Connect)
        </span>
      </div>
    </div>

    <div style="border-top: 1px solid var(--border); padding-top: 12px; display: flex; justify-content: flex-end;">
      <a href="/admin/youtube" class="btn btn-secondary btn-sm">View YouTube Module →</a>
    </div>
  </div>
</div>

<!-- Combined Recent Activity -->
<div class="card">
  <div class="card-header">
    <h2 class="card-title">Recent Activity Across Platforms</h2>
    <a href="/admin/instagram/activity" class="btn btn-secondary btn-sm">View Full Log →</a>
  </div>

  <% if (!recentActivity || recentActivity.length === 0) { %>
    <div class="empty-state" style="padding: 32px 16px;">
      <p>No activity recorded yet.</p>
    </div>
  <% } else { %>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-size: 12px;">
            <th style="padding: 8px 12px;">Platform</th>
            <th style="padding: 8px 12px;">Time</th>
            <th style="padding: 8px 12px;">Recipient / Author</th>
            <th style="padding: 8px 12px;">Keyword</th>
            <th style="padding: 8px 12px;">Status</th>
          </tr>
        </thead>
        <tbody>
          <% recentActivity.forEach(item => { %>
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 10px 12px;">
                <% if (item.platform === 'youtube') { %>
                  <span class="badge badge-yt" style="background-color: rgba(225, 29, 72, 0.12); color: #E11D48; font-weight: 600;">YouTube</span>
                <% } else { %>
                  <span class="badge badge-ig" style="background-color: rgba(108, 92, 231, 0.12); color: var(--primary); font-weight: 600;">Instagram</span>
                <% } %>
              </td>
              <td style="padding: 10px 12px; color: var(--muted); white-space: nowrap;">
                <%= new Date(item.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
              </td>
              <td style="padding: 10px 12px; font-weight: 500;">
                @<%= item.commenterUsername || item.author || 'unknown' %>
              </td>
              <td style="padding: 10px 12px;">
                <span class="chip" style="font-size: 11px; padding: 2px 8px;">
                  <%= item.matchedKeyword || '—' %>
                </span>
              </td>
              <td style="padding: 10px 12px;">
                <% if (item.status === 'sent' || item.status === 'posted') { %>
                  <span class="badge badge-active">Sent</span>
                <% } else if (item.status === 'failed') { %>
                  <span class="badge" style="background-color: rgba(220, 38, 38, 0.15); color: var(--danger);">Failed</span>
                <% } else { %>
                  <span class="badge badge-paused"><%= item.status %></span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
