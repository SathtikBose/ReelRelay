# Meta / Instagram API Credentials
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=invent_a_random_secret_verify_token_here
META_ACCESS_TOKEN=your_long_lived_instagram_graph_api_access_token
IG_BUSINESS_ACCOUNT_ID=your_instagram_professional_account_id

# Meta Graph API Version
GRAPH_API_VERSION=v23.0

# Admin Dashboard Security & Session Auth
ADMIN_PASSWORD=change_this_to_a_secure_password_min_12_chars
SESSION_SECRET=generate_32_plus_random_chars_for_hmac_signing

# Optional Backward-Compatibility Aliases
IG_APP_ID=your_meta_app_id
IG_APP_SECRET=your_meta_app_secret
IG_VERIFY_TOKEN=invent_a_random_secret_verify_token_here
IG_USER_ID=your_instagram_professional_account_id
IG_ACCESS_TOKEN=your_long_lived_instagram_graph_api_access_token
IG_API_VERSION=v23.0
