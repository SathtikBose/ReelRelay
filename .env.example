# Environment
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/reelrelay?retryWrites=true&w=majority

# Meta / Instagram API
IG_APP_ID=your_meta_app_id
IG_APP_SECRET=your_meta_app_secret
IG_VERIFY_TOKEN=your_webhook_verify_token
IG_USER_ID=your_instagram_user_id
IG_ACCESS_TOKEN=your_instagram_access_token_bootstrap
IG_API_VERSION=v23.0

# Security & Auth
ADMIN_PASSWORD=change_this_to_a_secure_password_min_12_chars
SESSION_SECRET=generate_32_plus_random_chars_for_session
CSRF_SECRET=generate_32_plus_random_chars_for_csrf
ENCRYPTION_KEY=64_hex_chars_32_bytes_random_crypto_key_for_aes_256_gcm

# Logging & Retention
LOG_LEVEL=info
LOG_TTL_DAYS=60
LOG_SKIPPED=false
